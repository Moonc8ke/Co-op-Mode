# Supabase credentials for the couples-app project.
# Copy this file to .env.local and fill in the values from your NEW Supabase
# project (Project Settings > API). Never commit real values.
# See README.md for the full setup steps.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
